{
  "name": "orion-waypoint",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Saves your tabs, AI chats and next step whenever you get pulled away, so you pick up exactly where you left off.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.capture.config.ts",
    "test": "vitest run && npm run icons:check",
    "harness": "vite --config vite.harness.config.ts",
    "icons": "node scripts/render-icons.mjs",
    "icons:check": "node scripts/render-icons.mjs --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/chrome": "^0.2.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.9"
  }
}
