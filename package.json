{
  "name": "orion-hud",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Context-aware workflow HUD browser extension.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.capture.config.ts && vite build --config bridge/vite.config.ts",
    "test": "vitest run",
    "harness": "vite --config vite.harness.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p bridge && tsc --noEmit -p e2e",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.2.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.9"
  }
}
